{
  "date": "2026-11-25",
  "scope": "egui legacy renderer 0.31.1 to 0.37.0; source/provenance review before compilation",
  "review": {
    "registry_archives": "All 48 added/version-changed lockfile packages verified against Cargo.lock and crates.io checksums; installed files compared with reviewed archives.",
    "official_sources": "Rust sources, shader sources, original manifests and bundled font binaries compared with official repository commits or release tags. Wgpu is an inactive optional renderer in this app.",
    "metadata_exceptions": [
      "Eight egui crate recorded commits returned 404; their source and font files match the official 0.37.0 tag.",
      "Wgpu crates omit VCS metadata; files match official v30.0.2 tag; platform helper uses wgpu-core/platform-deps/windows-linux-android.",
      "Glow source matches its recorded commit after CRLF/LF normalization.",
      "codespan-reporting manifest differs only in package version 0.13.0 to 0.13.1; epaint manifest differs only in one documentation feature name."
    ],
    "manual_review": [
      "Inspected all enum-map-derive production source: input-driven enum/struct token generation, no process/network/environment access.",
      "Inspected new build scripts: Wgpu/Naga scripts only declare configuration aliases; not selected for the Glow build.",
      "Checked font and rasterization source for process/network/environment behavior; no unexpected access found.",
      "Reviewed eframe inspection, screenshot and storage behavior: inspection is disabled; screenshot writes are requested by the app; storage and desktop activation variables have documented purposes.",
      "Retained license and bundled font notices, obtaining omitted texts from exact official sources.",
      "Both runtime Glow GLSL shaders inspected and matched byte-for-byte to the official release tag."
    ],
    "result": "No supply-chain attack indicators found in this review; checks cannot establish absence of upstream compromise."
  },
